#!/bin/bash
#
# Voice dictation - records with mic, transcribes, and types text
# Optionally translates before typing
#
# Translation backends: trans (default), ollama (translategemma)
# Configurable languages via environment variables:
#   DICTEE_LANG_SOURCE (default: system language), DICTEE_LANG_TARGET (default: en)
#
# Usage: dictee [--translate] [--ollama] [--llm] [--cancel] [--setup [--wizard]]
#              [--paste-clipboard|--paste-dotool]
#   dictee                      # transcribe and type
#   dictee --translate          # transcribe, translate (trans), type
#   dictee --translate --ollama # translate with ollama/translategemma
#   dictee --llm                # transcribe, improve with LLM, type
#   dictee --cancel             # cancel current recording
#   dictee --setup              # open configuration UI
#   dictee --setup --wizard     # open setup wizard
#   dictee --paste-clipboard    # force wl-copy+wl-paste+ydotool typing path
#   dictee --paste-dotool       # force dotool typing path
#
# Requires: transcribe-daemon (running), pw-record, dotool
# Optional: animation-speech-ctl (https://github.com/rcspam/animation-speech)

# === CONFIGURATION ===

# Load configuration (dictee-setup)
DICTEE_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/dictee.conf"

# Save LLM env overrides (CLI takes priority over config file)
declare -A _llm_saved
for _v in DICTEE_LLM_PROVIDER DICTEE_LLM_MODEL DICTEE_LLM_TIMEOUT \
          DICTEE_LLM_CPU DICTEE_LLM_ADDITIONAL_CONTEXT DICTEE_LLM_DEBUG \
          DICTEE_LLM_POSTPROCESS \
          DICTEE_LLM_OPENAI_COMPAT_URL DICTEE_LLM_OPENAI_COMPAT_KEY \
          OPENAI_API_KEY OPENROUTER_API_KEY GOOGLE_API_KEY GEMINI_API_KEY \
          ANTHROPIC_API_KEY GROQ_API_KEY; do
    if [[ -v "$_v" ]]; then
        _llm_saved["$_v"]="${!_v}"
    fi
done

[ -f "$DICTEE_CONF" ] && source "$DICTEE_CONF"

# Restore CLI overrides
for _v in "${!_llm_saved[@]}"; do
    declare "$_v=${_llm_saved[$_v]}"
    export "$_v"
done
unset _v _llm_saved

# Export OLLAMA_NUM_GPU if defined in config (forced CPU mode)
[ -n "$OLLAMA_NUM_GPU" ] && export OLLAMA_NUM_GPU

LANG_SOURCE="${DICTEE_LANG_SOURCE:-${LANG%%_*}}"
LANG_TARGET="${DICTEE_LANG_TARGET:-en}"
LANG_LABEL="${LANG_SOURCE^^}→${LANG_TARGET^^}"
CLIPBOARD="${DICTEE_CLIPBOARD:-true}"
ANIMATION="${DICTEE_ANIMATION:-speech}"
PASTE_MODE="${DICTEE_PASTE_MODE:-clipboard}"  # auto|clipboard|dotool

# Detect keyboard layout for dotool (localectl > setxkbmap > us)
if [ -z "$DOTOOL_XKB_LAYOUT" ]; then
    DOTOOL_XKB_LAYOUT=$(localectl status 2>/dev/null | awk '/X11 Layout/{print $3}')
    [ -z "$DOTOOL_XKB_LAYOUT" ] && DOTOOL_XKB_LAYOUT=$(setxkbmap -query 2>/dev/null | awk '/layout/{print $2}')
    DOTOOL_XKB_LAYOUT="${DOTOOL_XKB_LAYOUT:-us}"
fi
export DOTOOL_XKB_LAYOUT

RECORDING_FILE="$HOME/.cache/tmp_recording_dictee.mp3"
PIDFILE="/tmp/recording_dictee_pid"
ID_TMP_FILE="/tmp/notify_dictee"
MUT_FILE="/tmp/mut_dictee"
TRANSLATE_BACKEND_FILE="/tmp/translate_dictee_backend"
TRANSLATE_FLAG_FILE="/tmp/dictee_translate"
LLM_FLAG_FILE="/tmp/dictee_llm_postprocess"
LAST_WORD_FILE="/dev/shm/.dictee_last_word"

# Shared state with plasmoid/tray (protected by flock)
STATE_FILE="/dev/shm/.dictee_state"
STATE_LOCK="/dev/shm/.dictee_state.lock"

write_state() {
    (
        flock -n 200 || return 1
        echo "$1" > "$STATE_FILE"
    ) 200>"$STATE_LOCK"
}

# Text post-processing (regex rules + dictionary + optional LLM)
if [ "${DICTEE_POSTPROCESS:-true}" = "true" ] && command -v dictee-postprocess >/dev/null 2>&1; then
    SUPPRIME="| dictee-postprocess"
else
    SUPPRIME=""
fi

# Safe dotool wrapper for ERR trap
safe_dotool() {
    if dotool 2>/dev/null; then true; fi
}

# Type text via dotool, with newline handling and sanitization
# dotool does not support: U+00A0, U+202F, …, —, –, tab
# Replace them with ASCII equivalents before sending
type_text() {
    local text="$1"
    # Sanitize unsupported dotool characters (no subshell to preserve \n)
    text="${text//$'\xc2\xa0'/ }"
    text="${text//$'\xe2\x80\xaf'/ }"
    text="${text//$'\xe2\x80\xa6'/...}"
    text="${text//$'\xe2\x80\x94'/--}"
    text="${text//$'\xe2\x80\x93'/-}"
    # Convert to dotool commands: "type ..." + "key enter/tab" between segments
    printf '%s\n' "$text" | awk -v RS='\n' '{
        if (NR > 1) print "key enter"
        # Split on tabs
        n = split($0, parts, "\t")
        for (i = 1; i <= n; i++) {
            if (i > 1) print "key tab"
            if (parts[i] != "") printf "type %s\n", parts[i]
        }
    }' | safe_dotool
}

can_clipboard_paste() {
    [ "$XDG_SESSION_TYPE" = "wayland" ] || return 1
    command -v wl-copy >/dev/null 2>&1 || return 1
    command -v wl-paste >/dev/null 2>&1 || return 1
    command -v wtype >/dev/null 2>&1 || command -v dotool >/dev/null 2>&1 || return 1
    return 0
}

trigger_paste_shortcut() {
    # Prefer Shift+Insert, then Ctrl+V. This avoids layout-dependent typing.
    if command -v wtype >/dev/null 2>&1; then
        wtype -M shift -P Insert -m shift >/dev/null 2>&1 && return 0
        wtype -M ctrl -P v -m ctrl >/dev/null 2>&1 && return 0
    fi
    if command -v dotool >/dev/null 2>&1; then
        printf 'key shift+insert\n' | dotool >/dev/null 2>&1 && return 0
        printf 'key ctrl+v\n' | dotool >/dev/null 2>&1 && return 0
        return 1
    fi
    return 1
}

resolve_paste_mode() {
    case "$PASTE_MODE" in
        clipboard|dotool)
            echo "$PASTE_MODE"
            ;;
        auto|*)
            if can_clipboard_paste; then
                echo "clipboard"
            else
                echo "dotool"
            fi
            ;;
    esac
}

paste_with_clipboard() {
    local text="$1"
    # Real clipboard paste path: copy once and trigger paste shortcut.
    printf '%s' "$text" | wl-copy || return 1
    trigger_paste_shortcut || {
        echo "Dictee: could not trigger paste shortcut. Text was copied to clipboard." >&2
        return 1
    }
    return 0
}

paste_text() {
    local text="$1"
    local mode
    mode="$(resolve_paste_mode)"

    if [ "$mode" = "clipboard" ]; then
        if paste_with_clipboard "$text"; then
            return 0
        fi
        # Forced clipboard mode: keep text in clipboard and do not fallback to char-by-char typing.
        if [ "$PASTE_MODE" = "clipboard" ]; then
            echo "Dictee: clipboard mode forced and paste shortcut failed. Text is in clipboard." >&2
            return 0
        fi
    fi
    # Fallback path (and explicit dotool mode)
    copy_to_clipboard "$text"
    type_text "$text"
}

# Inter-press continuation: incomplete sentence detection
# Closed-class words indicating an unfinished sentence — loaded from
# continuation.conf.default (system) + ~/.config/dictee/continuation.conf (user)
load_continuation_words() {
    local file
    for file in "$@"; do
        [ -f "$file" ] || continue
        while IFS= read -r line; do
            line="${line%%#*}"             # remove comments
            line="${line#"${line%%[! ]*}"}" # trim start
            [[ "$line" == \[* ]] || continue
            local tag="${line%%]*}"
            tag="${tag#[}"
            local words="${line#*]}"
            local var="CONTINUATION_WORDS_${tag^^}"
            # Add words (cumulative)
            eval "${var}=\"\${${var}:-\" \"}\${words} \""
        done < "$file"
    done
}

_SCRIPT_DIR_CONT="$(dirname "$(readlink -f "$0")")"
_SYSTEM_CONT=""
for _c in "$_SCRIPT_DIR_CONT/continuation.conf.default" \
          "/usr/share/dictee/continuation.conf.default" \
          "${XDG_DATA_HOME:-$HOME/.local/share}/dictee/continuation.conf.default"; do
    [ -f "$_c" ] && { _SYSTEM_CONT="$_c"; break; }
done
_USER_CONT="${XDG_CONFIG_HOME:-$HOME/.config}/dictee/continuation.conf"

load_continuation_words ${_SYSTEM_CONT:+"$_SYSTEM_CONT"} ${_USER_CONT:+"$_USER_CONT"}
apply_continuation() {
    # Usage: apply_continuation VARNAME
    # Modify variable in-place (no subshell)
    # Buffer markers:
    #   , → comma (always continuation, space + lowercase)
    #   . → period (continuation if last word is closed-class, otherwise space + keep case)
    #   F → sentence end (! ? … ; : » )) — space + keep case
    #   _ → no punctuation (mid-sentence, space + lowercase)
    local -n _ref="$1"
    # If text starts with \n ("new line" command), do not modify
    if [[ "$_ref" == $'\n'* ]]; then return; fi
    if [ ! -f "$LAST_WORD_FILE" ]; then return; fi
    local saved
    saved=$(cat "$LAST_WORD_FILE" 2>/dev/null) || return
    local last_char="${saved%%:*}"
    local last_word="${saved#*:}"

    # Remove leading spaces (avoid double spaces if previous
    # text had trailing space, e.g.: "Hello, ")
    _ref="${_ref#"${_ref%%[! ]*}"}"

    # If the push starts with punctuation (voice command "comma",
    # "period", etc.), attach to previous text without space.
    local fc="${_ref:0:1}"
    if [[ "$fc" == [,.\;!?:] ]]; then
        # If previous was a period, always delete it:
        # user is explicitly correcting punctuation
        if [ "$last_char" = "." ]; then
            echo "key backspace" | safe_dotool
        fi
        # Lowercase only after , ; : (continuation)
        # Keep case after . ! ? (new sentence)
        # Exception: if prefix contains \n (e.g.: ":\n"), it's a new
        # paragraph → keep case (uppercase)
        if [[ "$fc" == [,\;:] ]]; then
            local prefix="${_ref%%[A-Za-zÀ-ÿ]*}"
            if [[ "$prefix" != *$'\n'* ]]; then
                local after="${_ref#"$prefix"}"
                if [ -n "$after" ]; then
                    _ref="${prefix}${after,}"
                fi
            fi
        fi
        return
    fi

    if [ "$last_char" = "," ]; then
        # After comma: always continue (space + lowercase)
        _ref=" ${_ref,}"
    elif [ "$last_char" = "." ]; then
        # After period: continue only if last word is closed-class
        # (backward check only — forward check is too aggressive and
        # may delete a period when Parakeet swallowed a voice command)
        local lower="${last_word,,}"
        local _cw_var="CONTINUATION_WORDS_${LANG_SOURCE^^}"
        local _cw="${!_cw_var}"
        if [[ -n "$_cw" && "$_cw" == *" $lower "* ]]; then
            echo "key backspace" | safe_dotool
            _ref=" ${_ref,}"
        else
            # Sentence ended: space, keep case
            _ref=" ${_ref}"
        fi
    elif [ "$last_char" = "F" ]; then
        # After ! ? … ; : » ): sentence ended, space + keep case
        _ref=" ${_ref}"
    elif [ "$last_char" = "_" ]; then
        # No punctuation: mid-sentence, space + lowercase
        _ref=" ${_ref,}"
    fi
}

save_last_word() {
    # Save punctuation marker and last word for continuation
    # Markers: , . F (end: ! ? … ; : » )) _ (no punctuation)
    local text="$1"
    # If text contains \n (voice command "new line"),
    # do not save: next press is independent
    if [[ "$text" == *$'\n'* ]]; then
        rm -f "$LAST_WORD_FILE"
        return
    fi
    # Remove trailing spaces (pure bash, no subshell)
    local trimmed="${text%"${text##*[! ]}"}"
    if [ -z "$trimmed" ]; then
        rm -f "$LAST_WORD_FILE"
        return
    fi

    local marker="" stripped=""

    # Check multi-character patterns first (ellipsis)
    if [[ "$trimmed" == *... ]]; then
        marker="F"
        stripped="${trimmed%...}"
    elif [[ "$trimmed" == *$'\xe2\x80\xa6' ]]; then
        # … (U+2026) — Unicode ellipsis
        marker="F"
        stripped="${trimmed%?}"
    else
        local last_char="${trimmed: -1}"
        stripped="${trimmed%?}"
        case "$last_char" in
            .)  marker="." ;;
            ,)  marker="," ;;
            '!'|'?'|';'|':'|$'\xbb')  marker="F" ;;
            ')')  marker="F" ;;
            *)  marker="_" ; stripped="$trimmed" ;;
        esac
    fi

    # Extract last word (before punctuation)
    if [ "$marker" != "_" ]; then
        stripped="${stripped%"${stripped##*[! ]}"}"
    fi
    local last_word="${stripped##* }"

    if [ -n "$last_word" ]; then
        echo "${marker}:${last_word}" > "$LAST_WORD_FILE"
    else
        rm -f "$LAST_WORD_FILE"
    fi
}

# Parse arguments — dictee.conf values serve as defaults,
# CLI arguments override them.
TRANSLATE_BACKEND="${DICTEE_TRANSLATE_BACKEND:-trans}"
TRANSLATE="${DICTEE_TRANSLATE:-false}"
LLM_POSTPROCESS="${DICTEE_LLM_POSTPROCESS:-false}"
CANCEL=false
NO_ESC_LISTENER=false

for arg in "$@"; do
    case "$arg" in
    --cancel)
        CANCEL=true
        ;;
    --no-esc-listener)
        NO_ESC_LISTENER=true
        ;;
    --translate)
        TRANSLATE=true
        ;;
    --ollama)
        TRANSLATE_BACKEND="ollama"
        ;;
    --llm)
        LLM_POSTPROCESS=true
        ;;
    --paste-clipboard)
        PASTE_MODE="clipboard"
        ;;
    --paste-dotool)
        PASTE_MODE="dotool"
        ;;
    --setup)
        shift
        exec dictee-setup "$@"
        ;;
    --wizard)
        exec dictee-setup --wizard
        ;;
    --help|-h)
        head -n 18 "$0" | grep '^#' | sed 's/^# \?//'
        exit 0
        ;;
    esac
done

# === FUNCTIONS ===

# === ESCAPE LISTENER (/dev/input) ===

ESC_LISTENER_PIDFILE="/tmp/dictee_esc_listener_pid"

start_escape_listener() {
    # Launch background listener reading /dev/input to detect ESC
    # Listens to all keyboards simultaneously. Requires 'input' group.
    stop_escape_listener
    # Find all physical keyboards (sysrq+kbd = real keyboard, exclude virtual)
    local kbd_devs
    kbd_devs=$(awk -f <(cat << 'AWKEOF'
/^N:/ { name = $0 }
/^H:.*sysrq.*kbd/ {
    if (name !~ /virtual|Virtual|uinput/) {
        match($0, /event[0-9]+/)
        if (RSTART) print "/dev/input/" substr($0, RSTART, RLENGTH)
    }
}
AWKEOF
    ) /proc/bus/input/devices)
    if [ -z "$kbd_devs" ]; then return; fi
    local self_path
    self_path="$(readlink -f "$0")"
    nohup python3 -c "
import struct, subprocess, signal, select, os
signal.signal(signal.SIGTERM, lambda *_: exit(0))
devs = '''$kbd_devs'''.strip().split('\n')
fds = []
for d in devs:
    try:
        fds.append(open(d, 'rb'))
    except (PermissionError, FileNotFoundError):
        pass
if not fds:
    exit(1)
while True:
    ready, _, _ = select.select(fds, [], [])
    for f in ready:
        data = f.read(24)
        if len(data) < 24:
            continue
        _s, _u, t, code, val = struct.unpack('llHHi', data)
        if t == 1 and code == 1 and val == 1:
            for ff in fds:
                ff.close()
            subprocess.Popen(['$self_path', '--cancel'])
            exit(0)
" >/dev/null 2>&1 &
    echo $! > "$ESC_LISTENER_PIDFILE"
    disown $!
}

stop_escape_listener() {
    if [ -f "$ESC_LISTENER_PIDFILE" ]; then
        local pid=""
        if pid=$(cat "$ESC_LISTENER_PIDFILE" 2>/dev/null); then
            if [ -n "$pid" ]; then
                if kill "$pid" 2>/dev/null; then true; fi
                if pkill -P "$pid" 2>/dev/null; then true; fi
            fi
        fi
        rm -f "$ESC_LISTENER_PIDFILE"
    fi
}

# === CLIPBOARD ===

copy_to_clipboard() {
    [ "$CLIPBOARD" = true ] || return 0
    if command -v wl-copy >/dev/null 2>&1 && [ "$XDG_SESSION_TYPE" = "wayland" ]; then
        echo "$1" | wl-copy
    elif command -v xclip >/dev/null 2>&1; then
        echo "$1" | xclip -selection clipboard
    elif command -v xsel >/dev/null 2>&1; then
        echo "$1" | xsel --clipboard --input
    fi
}

# === DEPENDENCIES ===

check_dependencies() {
    local missing=()
    command -v pw-record >/dev/null || missing+=("pipewire")
    case "$(resolve_paste_mode)" in
        clipboard)
            command -v wl-copy >/dev/null || missing+=("wl-clipboard")
            command -v wl-paste >/dev/null || missing+=("wl-clipboard")
            if ! command -v wtype >/dev/null 2>&1 && ! command -v dotool >/dev/null 2>&1; then
                missing+=("wtype or dotool")
            fi
            ;;
        *)
            command -v dotool >/dev/null || missing+=("dotool")
            ;;
    esac
    if ! command -v pactl >/dev/null; then
        missing+=("pulseaudio-utils or pipewire-pulse")
    fi
    command -v notify-send >/dev/null || missing+=("libnotify-bin")

    # Check translation backend if --translate
    if [ "$TRANSLATE" = true ]; then
        if [ "$TRANSLATE_BACKEND" = "trans" ]; then
            command -v trans >/dev/null || missing+=("translate-shell")
        elif [ "$TRANSLATE_BACKEND" = "libretranslate" ]; then
            command -v curl >/dev/null || missing+=("curl")
        elif [ "$TRANSLATE_BACKEND" = "ollama" ]; then
            command -v ollama >/dev/null || missing+=("ollama")
        fi
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        echo "Missing dependencies: ${missing[*]}" >&2
        exit 1
    fi
}

cleanup_on_error() {
    local exit_code=$?
    local err_line="${1:-unknown}"
    echo "$(date '+%F %T') ERR exit=$exit_code line=$err_line" >> /tmp/dictee-error.log

    stop_escape_listener

    # Kill pw-record and its children
    if [ -f "$PIDFILE" ]; then
        local rec_pid=$(cat "$PIDFILE")
        kill -- -"$rec_pid" 2>/dev/null || kill "$rec_pid" 2>/dev/null
        sleep 0.1
        kill -9 -- -"$rec_pid" 2>/dev/null || kill -9 "$rec_pid" 2>/dev/null
        rm -f "$PIDFILE"
    fi

    # Stop animation
    if [ "$ANIMATION" = "speech" ] || [ "$ANIMATION" = "both" ]; then
        if command -v animation-speech-ctl >/dev/null 2>&1; then
            animation-speech-ctl quit 2>/dev/null
        fi
    fi

    # Kill all remaining child processes
    pkill -P $$ 2>/dev/null

    # Restore audio state
    pactl set-sink-mute @DEFAULT_SINK@ 0
    if [ -f "$MUT_FILE" ]; then
        [[ $(awk -F"=" '{print $2}' "$MUT_FILE") == 1 ]] && pactl set-source-mute @DEFAULT_SOURCE@ 1
        rm -f "$MUT_FILE"
    fi

    # Close persistent notification
    local id=$(cat "$ID_TMP_FILE" 2>/dev/null)
    if [ -n "$id" ]; then
        notify-send --replace-id="$id" -t 3000 -i audio-chat-none-symbolic -a Dictee "Recording interrupted"
    fi

    rm -f "$ID_TMP_FILE" "$RECORDING_FILE" "$TRANSLATE_BACKEND_FILE" "$TRANSLATE_FLAG_FILE" "$LLM_FLAG_FILE" "$LAST_WORD_FILE"

    write_state "idle"
    exit $exit_code
}

transcribe() {
    local audio_file="$1"
    eval transcribe-client "$audio_file" $SUPPRIME
}

translate() {
    local text="$1"
    local backend="$2"

    case "$backend" in
    trans)
        local engine="${DICTEE_TRANS_ENGINE:-google}"
        echo "$text" | timeout 15 trans -b -e "$engine" "${LANG_SOURCE}:${LANG_TARGET}"
        ;;
    libretranslate)
        local port="${DICTEE_LIBRETRANSLATE_PORT:-5000}"
        local base_url="http://localhost:${port}"
        # Check that LibreTranslate is accessible and languages are available
        local avail_langs
        if ! avail_langs=$(curl -s --max-time 3 --connect-timeout 2 "${base_url}/languages" 2>/dev/null) || [ -z "$avail_langs" ]; then
            echo "LibreTranslate error: server unreachable on port ${port}. Check container and network." >&2
            return 1
        fi
        local missing=""
        if ! echo "$avail_langs" | python3 -c "import json,sys; codes=[l['code'] for l in json.load(sys.stdin)]; sys.exit(0 if '${LANG_SOURCE}' in codes else 1)" 2>/dev/null; then
            missing="${LANG_SOURCE}"
        fi
        if ! echo "$avail_langs" | python3 -c "import json,sys; codes=[l['code'] for l in json.load(sys.stdin)]; sys.exit(0 if '${LANG_TARGET}' in codes else 1)" 2>/dev/null; then
            if [ -n "$missing" ]; then
                missing="${missing}, ${LANG_TARGET}"
            else
                missing="${LANG_TARGET}"
            fi
        fi
        if [ -n "$missing" ]; then
            local supported
            supported=$(echo "$avail_langs" | python3 -c "import json,sys; print(', '.join(l['code'] for l in json.load(sys.stdin)))" 2>/dev/null)
            echo "LibreTranslate error: unsupported language(s): ${missing} (available: ${supported}). Restart container with --load-only including those languages." >&2
            return 1
        fi
        # Escape text for JSON
        local json_text
        json_text=$(printf '%s' "$text" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')
        local result
        result=$(curl -s --max-time 10 "${base_url}/translate" \
            -H "Content-Type: application/json" \
            -d "{\"q\":${json_text},\"source\":\"${LANG_SOURCE}\",\"target\":\"${LANG_TARGET}\"}")
        if echo "$result" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["translatedText"])' 2>/dev/null; then
            :
        else
            echo "LibreTranslate error: $result" >&2
            return 1
        fi
        ;;
    ollama)
        local model="${DICTEE_OLLAMA_MODEL:-translategemma}"
        # Check if model is already downloaded
        if ! ollama list 2>/dev/null | grep -q "${model%%:*}"; then
            notify-send -t 0 -i emblem-downloads -a Dictee "Downloading model ${model}..." "First launch, please wait"
        fi
        local prompt="You are a professional ${LANG_SOURCE} to ${LANG_TARGET} translator. Your goal is to accurately convey the meaning and nuances of the original text while adhering to the target language grammar, vocabulary, and cultural sensitivities.
Produce only the ${LANG_TARGET} translation, without any additional explanations or commentary. Please translate the following text:

${text}"
        # Add :latest only if no explicit tag
        [[ "$model" == *:* ]] || model="${model}:latest"
        timeout 30 ollama run "$model" "$prompt" 2>/dev/null
        ;;
    *)
        echo "Unknown translation backend: $backend" >&2
        return 1
        ;;
    esac
}

# === MAIN ===

check_dependencies
trap 'cleanup_on_error $LINENO' INT TERM HUP QUIT ERR

# === CANCELLATION (idempotent via flock) ===
if [ "$CANCEL" = true ]; then
    trap - ERR
    (
        flock -n 200 || exit 0          # another cancel holds the lock → no-op
        current=$(cat "$STATE_FILE" 2>/dev/null)
        if [ "$current" = "cancelled" ]; then exit 0; fi  # already cancelled
        if [ "$current" = "idle" ]; then exit 0; fi        # nothing to cancel
        echo "cancelled" > "$STATE_FILE"
    ) 200>"$STATE_LOCK"

    if [ -f "$PIDFILE" ]; then
        id=$(cat "$ID_TMP_FILE" 2>/dev/null)

        stop_escape_listener

        # Stop animation
        if [ "$ANIMATION" = "speech" ] || [ "$ANIMATION" = "both" ]; then
            if command -v animation-speech-ctl >/dev/null 2>&1; then
                if animation-speech-ctl quit 2>/dev/null; then true; fi
            fi
        fi

        # Restore microphone state
        if [ -f "$MUT_FILE" ]; then
            was_muted=""
            if was_muted=$(awk -F"=" '{print $2}' "$MUT_FILE" 2>/dev/null); then
                if [ "$was_muted" = "1" ]; then
                    pactl set-source-mute @DEFAULT_SOURCE@ 1
                fi
            fi
            rm -f "$MUT_FILE"
        fi
        pactl set-sink-mute @DEFAULT_SINK@ 0

        # Stop recording
        if [ -f "$PIDFILE" ]; then
            cancel_pid=""
            if cancel_pid=$(cat "$PIDFILE" 2>/dev/null); then
                if [ -n "$cancel_pid" ]; then
                    if kill "$cancel_pid" 2>/dev/null; then
                        true
                    fi
                fi
            fi
            rm -f "$PIDFILE"
        fi

        if [ -n "$id" ]; then
            notify-send --replace-id="$id" -t 3000 -i audio-chat-none-symbolic -a Dictee "Recording cancelled"
        else
            notify-send -t 3000 -i audio-chat-none-symbolic -a Dictee "Recording cancelled"
        fi
        rm -f "$ID_TMP_FILE" "$RECORDING_FILE" "$TRANSLATE_BACKEND_FILE" "$TRANSLATE_FLAG_FILE" "$LLM_FLAG_FILE"
    fi
    exit 0
fi

if [ -f "$PIDFILE" ]; then
    # === STOP RECORDING ===
    # Disable ERR trap during this section (too many external commands
    # that may legitimately return non-zero: kill, pactl, ffmpeg, etc.)
    trap - ERR

    stop_escape_listener

    # Retrieve options used at startup
    if [ -f "$TRANSLATE_FLAG_FILE" ]; then
        TRANSLATE=true
    fi
    if [ -f "$TRANSLATE_BACKEND_FILE" ]; then
        TRANSLATE_BACKEND=$(cat "$TRANSLATE_BACKEND_FILE")
    fi
    if [ -f "$LLM_FLAG_FILE" ]; then
        LLM_POSTPROCESS=true
    fi

    id=$(cat "$ID_TMP_FILE" 2>/dev/null)

    # Stop animation
    if [ "$ANIMATION" = "speech" ] || [ "$ANIMATION" = "both" ]; then
        if command -v animation-speech-ctl >/dev/null 2>&1; then
            if animation-speech-ctl stop 2>/dev/null; then true; fi
        fi
    fi

    # Restore microphone state
    if [ -f "$MUT_FILE" ]; then
        was_muted=""
        if was_muted=$(awk -F"=" '{print $2}' "$MUT_FILE" 2>/dev/null); then
            if [ "$was_muted" = "1" ]; then
                pactl set-source-mute @DEFAULT_SOURCE@ 1
            fi
        fi
        rm -f "$MUT_FILE"
    fi
    # Unmute audio
    pactl set-sink-mute @DEFAULT_SINK@ 0

    # Signal plasmoid
    write_state "transcribing"

    # Stop recording
    if [ -f "$PIDFILE" ]; then
        rec_pid=""
        if rec_pid=$(cat "$PIDFILE" 2>/dev/null); then
            if [ -n "$rec_pid" ]; then
                if kill "$rec_pid" 2>/dev/null; then
                    true
                fi
            fi
        fi
        rm -f "$PIDFILE"
    fi

    if [ -n "$id" ]; then
        notify-send --replace-id="$id" -t 30000 -i audio-chat-none-symbolic -a Dictee "Recording stopped"
    fi

    raw=$(eval transcribe-client "$RECORDING_FILE")
    if [ -n "$SUPPRIME" ]; then
        echo "$raw" | DICTEE_LLM_POSTPROCESS="$LLM_POSTPROCESS" dictee-postprocess > /dev/shm/.dictee_pp
        transcribed=$(cat /dev/shm/.dictee_pp; printf x)
        transcribed="${transcribed%x}"
        rm -f /dev/shm/.dictee_pp
    else
        transcribed="$raw"
    fi

    # Remove trailing spaces (never significant, avoids double spaces
    # when continuation adds a space to the next push)
    transcribed="${transcribed%"${transcribed##*[! ]}"}"

    # Inter-press continuation: adapt text if previous sentence is incomplete
    apply_continuation transcribed

    if [ "$TRANSLATE" = true ]; then
        # Translate and copy
        if [ -n "$id" ]; then
            notify-send --replace-id="$id" -t 30000 -i audio-chat-none-symbolic -a Dictee "Translating..."
        fi

        translated=$(translate "$transcribed" "$TRANSLATE_BACKEND" 2>/dev/null) || translated=""
        if [ -n "$translated" ]; then
            paste_text "$translated"
            save_last_word "$translated"

            if [ -n "$id" ]; then
                notify-send --replace-id="$id" -t 5000 -i clipboard-paste-symbolic -a Dictee "$LANG_LABEL ($TRANSLATE_BACKEND):" "<i>\"$transcribed\"</i> → <b>\"$translated\"</b>"
            else
                notify-send -t 5000 -i clipboard-paste-symbolic -a Dictee "$LANG_LABEL ($TRANSLATE_BACKEND):" "<i>\"$transcribed\"</i> → <b>\"$translated\"</b>"
            fi
        else
            # Translation failed — type original text
            paste_text "$transcribed"
            save_last_word "$transcribed"

            if [ -n "$id" ]; then
                notify-send --replace-id="$id" -t 5000 -i dialog-warning-symbolic -a Dictee "Translation failed ($TRANSLATE_BACKEND)" "<i>\"$transcribed\"</i>"
            else
                notify-send -t 5000 -i dialog-warning-symbolic -a Dictee "Translation failed ($TRANSLATE_BACKEND)" "<i>\"$transcribed\"</i>"
            fi
        fi
    else
        # Copy directly
        paste_text "$transcribed"
        save_last_word "$transcribed"

        if [ -n "$id" ]; then
            notify-send --replace-id="$id" -t 5000 -i clipboard-paste-symbolic -a Dictee "Typed text:" "<i>\"$transcribed\"</i>"
        else
            notify-send -t 5000 -i clipboard-paste-symbolic -a Dictee "Typed text:" "<i>\"$transcribed\"</i>"
        fi
    fi

    rm -f "$ID_TMP_FILE" "$RECORDING_FILE" "$TRANSLATE_BACKEND_FILE" "$TRANSLATE_FLAG_FILE" "$LLM_FLAG_FILE"
    write_state "idle"

    # Re-enable ERR trap
    trap 'cleanup_on_error $LINENO' INT TERM HUP QUIT ERR

else
    # === START RECORDING ===

    if [ "$NO_ESC_LISTENER" = false ]; then start_escape_listener; fi

    # Save chosen options
    if [ "$TRANSLATE" = true ]; then
        touch "$TRANSLATE_FLAG_FILE"
        echo "$TRANSLATE_BACKEND" >"$TRANSLATE_BACKEND_FILE"
    fi
    if [ "$LLM_POSTPROCESS" = true ]; then
        touch "$LLM_FLAG_FILE"
    fi

    # Check if microphone is muted and unmute it
    if pactl get-source-mute @DEFAULT_SOURCE@ | grep -q -i -E 'oui|yes'; then
        pactl set-source-mute @DEFAULT_SOURCE@ 0
        echo "MUT=1" >"$MUT_FILE"
    fi
    # Mute audio (to avoid feedback)
    pactl set-sink-mute @DEFAULT_SINK@ 1

    # Launch animation (if speech or both mode, and if available)
    if [ "$ANIMATION" = "speech" ] || [ "$ANIMATION" = "both" ]; then
        if command -v animation-speech-ctl >/dev/null 2>&1; then
            SCRIPT_PATH="$(readlink -f "$0")"
            if animation-speech-ctl launch --on-escape "$SCRIPT_PATH --cancel" 2>/dev/null; then true; fi
        fi
    fi

    # Start recording FIRST (before notification/plasmoid to not lose anything)
    pw-record --rate 16000 --channels 1 --format s16 "$RECORDING_FILE" &
    echo $! >"$PIDFILE"

    # Wait for pw-record to connect to PipeWire (~200ms startup latency)
    # The notification serves as a natural delay: the user waits for visual feedback
    # before speaking, which gives pw-record time to start

    # Signal plasmoid
    write_state "recording"

    # Notification (also serves as delay for pw-record)
    if [ "$TRANSLATE" = true ]; then
        notify-send -p -t 0 -i audio-chat-symbolic -a Dictee "Recording $LANG_LABEL ($TRANSLATE_BACKEND)" >"$ID_TMP_FILE"
    else
        notify-send -p -t 0 -i audio-chat-symbolic -a Dictee "Recording started" >"$ID_TMP_FILE"
    fi
fi
